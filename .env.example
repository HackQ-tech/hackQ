# Site identity (used in meta tags, sitemap, emails and the legal pages)
SITE_NAME=HackQ
SITE_DESCRIPTION=HackQ is a community for hackers, developers and curious minds. Share CVEs, CTF events, projects and tutorials.
CONTACT_EMAIL=contact@hackq.tech
TWITTER_HANDLE=
LEGAL_JURISDICTION=
PORT=3000
BASE_URL=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/hackq
JWT_SECRET=change_me_to_a_long_random_string

# First admin account (created automatically on boot)
ADMIN_EMAIL=admin@hackq.dev
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123

# Where bug reports are emailed (comma separated). Falls back to ADMIN_EMAIL.
BUG_REPORT_EMAIL=

# Email via Resend (https://resend.com). Leave empty in development: codes are printed in the server console.
RESEND_API_KEY=
# Use a full address on a domain you verified in Resend (quotes recommended):
MAIL_FROM="HackQ <mail@yourdomain.com>"

# Cloudinary (https://cloudinary.com) - image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Giphy (https://developers.giphy.com) - free API key for GIFs in comments
GIPHY_API_KEY=

# OAuth (optional). Callback URLs: BASE_URL/api/auth/google/callback and BASE_URL/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
